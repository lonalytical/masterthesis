@article{vanroijMeasuringHealthrelatedQuality2018,
  title = {Measuring Health-Related Quality of Life in Patients with Advanced Cancer: A Systematic Review of Self-Administered Measurement Instruments},
  shorttitle = {Measuring Health-Related Quality of Life in Patients with Advanced Cancer},
  author = {Van Roij, Janneke and Fransen, Heidi and {Van De Poll-Franse}, Lonneke and Zijlstra, Myrte and Raijmakers, Natasja},
  year = 2018,
