@article{matsumotoQualityLifeQuestionnairea,
  title = {The Quality of Life Questionnaire for Cancer Patients Treated with Anticancer Drugs ({{QOL-ACD}}): {{Validity}} and Reliability in {{Japanese}} Patients with Advanced Non-Small-Cell Lung Cancer},
