  author = {De Rooij, Belle H. and Ikiz, Habibe and Boll, Dorry and Pijnenborg, Johanna M.A. and Pijlman, Brenda M. and Kruitwagen, Roy F.P.M. and {Van De Poll-Franse}, Lonneke V. and Vos, M. Caroline and Ezendam, Nicole P.M.},
