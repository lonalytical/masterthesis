  urldate = {2026-01-22},
  abstract = {Patients enter the healthcare space shouldering a lot of personal stress. Concurrently, health care providers and staff are managing their own personalstressors as well as workplace stressors. As stress can negatively affect the patient--provider experience and cognitive function of both individuals, it is imperative to try to uplift the health care environment for all. Part of the healthcare environmental psychology strategy to reduce stress often includes televisions in waiting rooms, cafeterias, and elsewhere, with the intent to distract the viewer and make waiting easier. Although well-intentioned, many select programming which can induce stress (eg, news). In contrast, as positive media can induce desirable changes in mood, it is possible to use it to decrease stress and uplift viewers, including staff. Positive media includes both nature media, which can relax and calm viewers and kindness media, which uplifts viewers, induces calm, and promotes interpersonal connection and generosity. Careful consideration of waiting room media can affect the patient--provider experience.},
  langid = {english},
  file = {C:\Users\lonaf\Zotero\storage\XKFKJNXG\Fryburg - 2021 - What's Playing in Your Waiting Room Patient and Provider Stress and the Impact of Waiting Room Medi.pdf}
}

