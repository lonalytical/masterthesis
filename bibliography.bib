  author = {Tekinhatun, Muhammed and Alver, Kadir Han and Akbudak, {\.I}brahim and Turmak, Mehmet and {\c C}avdar, Eyyup and Deniz, Muhammed Akif},
  year = 2025,
  month = apr,
